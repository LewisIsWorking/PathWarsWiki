// 2026-08-10: Route 3, Exceptional Schedule into Centur-Ion Legatia.
// The Diagram Token handed to the opponent is not modelled as a step, because a Token is not a
// card in the vocabulary. Its purpose is to satisfy Urgent Schedule's activation condition
// ("your opponent controls more monsters than you"), and this model does not check activation
// conditions - only material legality, locks, limits and zones.
module crystron.RouteSchedule

import "Combo.pkl"

route: Combo.Route = new {
  name = "Exceptional Schedule into Centur-Ion Legatia"
  build = "yukinon"
  opening { "Exceptional Schedule"; "Crystron Smiger" }
  steps {
    new { n = 1; card = "Exceptional Schedule"; action = "activate"; from = "hand"; to = "gy"
          oncePerTurn = "Exceptional Schedule:search"
          text = "Add Urgent Schedule, then hand the opponent a level 10 Diagram Token." }

    new { n = 2; card = "Urgent Schedule"; action = "search"; from = "deck"; to = "hand"
          text = "Searched by Exceptional Schedule." }

    new { n = 3; card = "Urgent Schedule"; action = "activate"; from = "hand"; to = "gy"
          oncePerTurn = "Urgent Schedule:summon"
          text = "Live because the token means the opponent controls more monsters than you." }

    new { n = 4; card = "Scrap Recycler"; action = "special-summon"; from = "deck"; to = "field"
          text = "The level 4 or lower EARTH machine. Effects NEGATED, so it does NOT mill." }

    new { n = 5; card = "Night Train Blue Traveler"; action = "special-summon"; from = "deck"; to = "field"
          text = "The level 5 or higher EARTH machine. Also negated." }

    new { n = 6; card = "Crystron Smiger"; action = "normal-summon"; from = "hand"; to = "field"
          text = "Normal summon Smiger to fetch a tuner." }

    new { n = 7; card = "Scrap Recycler"; action = "destroy"; from = "field"; to = "gy"
          text = "Smiger targets a face-up card YOU control and destroys it." }

    new { n = 8; card = "Crystron Tristaros"; action = "special-summon"; from = "deck"; to = "field"
          appliesLock = "machine-synchro"
          oncePerTurn = "Crystron Smiger:summon"
          text = "Smiger summons a Crystron tuner from deck. Locks Machine SYNCHRO: no Xyz this turn." }

    new { n = 9; card = "Centur-Ion Legatia"; action = "synchro"; from = "extra"; to = "field"
          result = "Centur-Ion Legatia"
          materials { "Night Train Blue Traveler"; "Crystron Tristaros" }
          text = "10 + 2 = 12. On summon: draw 1, destroy the opponent's highest ATK monster, which is the token you gave them." }
  }
}
