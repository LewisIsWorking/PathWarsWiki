// Master Duel combo route model. Pkl side of the bake-off.
module crystron.Combo

import "Cards.pkl"
import "Rules.pkl"

typealias Zone = "hand"|"deck"|"field"|"gy"|"banished"|"extra"|"opponent-field"

typealias Lock = "none"|"machine"|"machine-synchro"

typealias Action = "activate"|"normal-summon"|"special-summon"|"synchro"|"xyz"|"link"|"search"|"mill"|"destroy"|"banish"

class Step {
  n: Int(this > 0)
  card: String(Cards.cards.containsKey(this))
  action: Action
  text: String(!isEmpty)
  /// Where the card is when it acts. Checked against the tracked state.
  from: Zone
  /// Where it ends up. null means it does not move.
  to: Zone?
  materials: Listing<String> = new Listing {}
  result: String?
  appliesLock: Lock = "none"
  /// Identifier for a once-per-turn effect, e.g. "Crystron Inclusion:search".
  oncePerTurn: String?
  /// Identifier for a once-per-DUEL effect, e.g. "Night Train Blue Traveler:revive".
  oncePerDuel: String?
  /// Extra Normal Summons this step grants (Flying Launcher grants 1 Machine).
  grantsNormalSummon: Int = 0
  /// Set when the step uses a card's documented alternate summon path.
  usesAltSummon: Boolean = false
  /// 2026-08-10: The Level this card BECOMES, when an effect changes it.
  /// Revolving Switchyard summons a Level 4 EARTH Machine and makes it Level 10; without this
  /// the model rejects a correct Rank 10 line because the material is still Level 4 on paper.
  /// Modelling Route 2 is what surfaced the gap.
  becomesLevel: Int?
}

class Route {
  name: String(!isEmpty)
  build: "amelia"|"yukinon"
  /// The opening hand this route assumes.
  opening: Listing<String>
  steps: Listing<Step>

  hidden stepList: List<Step> = steps.toList()
  hidden deck: Map<String, Int> = Rules.decks[build].toMap()

  function facts(c: String): Cards.CardFacts = Cards.cards[c]
  function isExtra(c: String): Boolean = List("synchro", "xyz", "link").contains(facts(c).kind)
  function levelOf(c: String): Int = facts(c).level

  /// 2026-08-10: The EFFECTIVE Level of a card at the point step index `i` resolves, i.e. its
  /// printed Level unless an earlier step changed it. Material checks must use this, not the
  /// printed Level, or a legal line that relies on a Level change reads as illegal.
  hidden levelChanges: List<Step> = stepList.filter((s) -> s.becomesLevel != null)
  function effectiveLevel(c: String, i: Int): Int =
    let (changed = levelChanges.filter((s) -> s.card == c && stepList.indexOf(s) < i))
      if (changed.isEmpty) levelOf(c) else changed.last.becomesLevel!!

  // ---- zone tracking -------------------------------------------------------
  hidden startZones: Map<String, String> =
    deck.keys.fold(Map(), (acc, c) -> acc.put(c, if (isExtra(c)) "extra" else "deck"))
  hidden initialZones: Map<String, String> =
    opening.toList().fold(startZones, (acc, c) -> acc.put(c, "hand"))

  function applyStep(acc: Map<String, String>, s: Step): Map<String, String> =
    let (moved = if (s.to != null) acc.put(s.card, s.to) else acc)
      s.materials.toList().fold(moved, (m, mat) -> m.put(mat, if (s.action == "xyz") "attached" else "gy"))

  function zonesBefore(i: Int): Map<String, String> =
    stepList.take(i).fold(initialZones, (acc, s) -> applyStep(acc, s))

  // ---- checks --------------------------------------------------------------

  /// R2. Every card named must actually be in this build's decklist.
  hidden deckErrors: List<String> = stepList
    .filter((s) -> !deck.containsKey(s.card))
    .map((s) -> "step \(s.n): \(s.card) is not in the \(build) decklist")

  /// R9. The acting card must really be in the zone the step claims.
  hidden zoneErrors: List<String> = IntSeq(0, stepList.length - 1).toList()
    .filter((i) -> zonesBefore(i).getOrNull(stepList[i].card) != stepList[i].from)
    .map((i) -> "step \(stepList[i].n): \(stepList[i].card) is claimed to act from \(stepList[i].from), but it is in \(zonesBefore(i).getOrNull(stepList[i].card) ?? "nowhere tracked")")

  /// R9b. Materials must be on the field when consumed.
  hidden materialZoneErrors: List<String> = IntSeq(0, stepList.length - 1).toList()
    .flatMap((i) -> stepList[i].materials.toList()
      .filter((m) -> zonesBefore(i).getOrNull(m) != "field")
      .map((m) -> "step \(stepList[i].n): material \(m) is not on the field, it is in \(zonesBefore(i).getOrNull(m) ?? "nowhere tracked")"))

  /// R3. One Normal Summon per turn, plus anything granted earlier in the route.
  hidden normalSummonErrors: List<String> =
    let (used = stepList.filter((s) -> s.action == "normal-summon").length)
    let (granted = stepList.map((s) -> s.grantsNormalSummon).fold(0, (a, b) -> a + b))
      if (used > 1 + granted)
        List("route uses \(used) Normal Summons but only \(1 + granted) are available")
      else List()

  /// R3b. A Normal Summon must come from the HAND.
  /// 2026-08-10: found while writing RouteFlyingLauncher. The zone check only asserts the claimed
  /// zone matches the tracked one, so "Normal Summon Scrap Recycler from the deck" passed happily:
  /// Recycler really WAS in the deck. Matching a claim is not the same as the claim being legal.
  hidden normalSummonZoneErrors: List<String> = stepList
    .filter((s) -> s.action == "normal-summon" && s.from != "hand")
    .map((s) -> "step \(s.n): \(s.card) is Normal Summoned from \(s.from), but a Normal Summon must come from the hand")

  /// R4/R5/R6. Material composition against the authored rule for the result.
  hidden materialErrors: List<String> = stepList
    .filter((s) -> List("synchro", "xyz", "link").contains(s.action) && !s.usesAltSummon)
    .flatMap((s) -> checkMaterials(s))

  function checkMaterials(s: Step): List<String> =
    let (rule = Rules.requirements.toMap().getOrNull(s.result))
      if (rule == null) List("step \(s.n): no material rule authored for \(s.result)")
      else checkCount(s, rule) + checkTuners(s, rule) + checkLevels(s, rule) + checkRace(s, rule)

  /// Material Levels are read AS AT this step, so a Level changed earlier in the route counts.
  function matLevels(s: Step): List<Int> =
    s.materials.toList().map((m) -> effectiveLevel(m, stepList.indexOf(s)))

  function checkCount(s: Step, rule: Rules.MaterialRule): List<String> =
    let (n = s.materials.toList().length)
      if (n < rule.minMaterials) List("step \(s.n): \(s.result) needs at least \(rule.minMaterials) materials, got \(n)")
      else if (rule.maxMaterials != null && n > rule.maxMaterials) List("step \(s.n): \(s.result) takes at most \(rule.maxMaterials) materials, got \(n)")
      else List()

  function checkTuners(s: Step, rule: Rules.MaterialRule): List<String> =
    let (t = s.materials.toList().filter((m) -> facts(m).tuner).length)
      if (t < rule.minTuners) List("step \(s.n): \(s.result) needs at least \(rule.minTuners) Tuner(s), got \(t)")
      else if (rule.maxTuners != null && t > rule.maxTuners) List("step \(s.n): \(s.result) takes at most \(rule.maxTuners) Tuner(s), got \(t)")
      else List()

  function checkLevels(s: Step, rule: Rules.MaterialRule): List<String> =
    let (lv = matLevels(s))
    let (total = lv.fold(0, (a, b) -> a + b))
      if (rule.levelsMustTotal && total != levelOf(s.result))
        List("step \(s.n): materials total \(total), but \(s.result) is Level \(levelOf(s.result))")
      // 2026-08-10: joined by hand rather than interpolating the list, because Pkl renders a List
      // as `List(10, 10, 4)` and CUE as `[10, 10, 4]`. The runner diffs message STRINGS, so any
      // rendering difference reads as the two models disagreeing.
      else if (rule.sameLevel && lv.any((l) -> l != levelOf(s.result)))
        List("step \(s.n): \(s.result) is Rank \(levelOf(s.result)) but materials are Levels \(lv.join(", "))")
      else List()

  function checkRace(s: Step, rule: Rules.MaterialRule): List<String> =
    if (rule.requiresRace != null && s.materials.toList().any((m) -> facts(m).race != rule.requiresRace))
      List("step \(s.n): \(s.result) requires \(rule.requiresRace) materials")
    else List()

  /// R7. The Extra Deck lock. machine-synchro forbids Xyz and Link outright;
  /// machine forbids summoning a non-Machine from the Extra Deck.
  hidden lockErrors: List<String> = stepList
    .filter((s) -> List("synchro", "xyz", "link").contains(s.action))
    .flatMap((s) -> checkLock(s))

  function priorLocks(s: Step, kind: String): List<Step> =
    stepList.filter((t) -> t.n < s.n && t.appliesLock == kind)

  function checkLock(s: Step): List<String> =
    let (synchroLocks = priorLocks(s, "machine-synchro"))
    let (machineLocks = priorLocks(s, "machine"))
      if (synchroLocks.length > 0 && s.action != "synchro")
        List("step \(s.n): \(s.action) summon of \(s.result) is illegal. \(synchroLocks.first.card) applied the Machine Synchro lock at step \(synchroLocks.first.n)")
      else if (synchroLocks.length > 0 && facts(s.result).race != "Machine")
        List("step \(s.n): \(s.result) is not a Machine, blocked by the lock from step \(synchroLocks.first.n)")
      else if (machineLocks.length > 0 && facts(s.result).race != "Machine")
        List("step \(s.n): \(s.result) is not a Machine, blocked by the Machine lock from step \(machineLocks.first.n)")
      else List()

  /// R8. Once per turn and once per Duel effects.
  hidden optErrors: List<String> =
    let (keys = stepList.filter((s) -> s.oncePerTurn != null).map((s) -> s.oncePerTurn))
      keys.distinct
        .filter((k) -> keys.filter((x) -> x == k).length > 1)
        .map((k) -> "once per turn effect used \(keys.filter((x) -> x == k).length) times: \(k)")

  hidden opdErrors: List<String> =
    let (keys = stepList.filter((s) -> s.oncePerDuel != null).map((s) -> s.oncePerDuel))
      keys.distinct
        .filter((k) -> keys.filter((x) -> x == k).length > 1)
        .map((k) -> "ONCE PER DUEL effect used \(keys.filter((x) -> x == k).length) times: \(k)")

  /// Everything, so one run reports every problem.
  errors: List<String> =
    deckErrors + zoneErrors + materialZoneErrors + normalSummonErrors +
    normalSummonZoneErrors + materialErrors + lockErrors + optErrors + opdErrors
}
